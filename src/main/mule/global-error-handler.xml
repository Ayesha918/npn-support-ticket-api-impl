<?xml version="1.0" encoding="UTF-8"?>
<mule xmlns="http://www.mulesoft.org/schema/mule/core"
      xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core"
      xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd">

    <error-handler name="global-error-handler">

        <on-error-propagate type="CUSTOM:VALIDATION_FAILED, APIKIT:BAD_REQUEST" logException="false" doc:name="400 Field errors">
            <set-variable variableName="httpStatus" value="#[400]"/>
            <ee:transform doc:name="Error body">
                <ee:message><ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
  errorCode: "VALIDATION_ERROR",
  message: error.description default "Request validation failed.",
  correlationId: vars.correlationId default correlationId,
  errors: vars.validationErrors default [{ code: "INVALID_REQUEST", message: error.description default "Bad request" }]
}]]></ee:set-payload></ee:message>
            </ee:transform>
        </on-error-propagate>

        <on-error-propagate type="CUSTOM:UNKNOWN_CUSTOMER" logException="false" doc:name="422 Unknown customer">
            <set-variable variableName="httpStatus" value="#[422]"/>
            <ee:transform doc:name="Error body">
                <ee:message><ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
  errorCode: "UNKNOWN_CUSTOMER",
  message: error.description,
  field: "customerId",
  correlationId: vars.correlationId default correlationId
}]]></ee:set-payload></ee:message>
            </ee:transform>
        </on-error-propagate>

        <on-error-propagate type="CUSTOM:UNKNOWN_PRODUCT" logException="false" doc:name="422 Unknown product">
            <set-variable variableName="httpStatus" value="#[422]"/>
            <ee:transform doc:name="Error body">
                <ee:message><ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
  errorCode: "UNKNOWN_PRODUCT",
  message: error.description,
  field: "productCode",
  correlationId: vars.correlationId default correlationId
}]]></ee:set-payload></ee:message>
            </ee:transform>
        </on-error-propagate>
		<on-error-propagate type="CUSTOM:TICKET_NOT_FOUND, APIKIT:NOT_FOUND" logException="false" doc:name="404 Ticket not found">
    <set-variable variableName="httpStatus" value="#[404]"/>
    <ee:transform doc:name="Error body">
        <ee:message><ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
  errorCode: "TICKET_NOT_FOUND",
  message: error.description,
  correlationId: vars.correlationId default correlationId
}]]></ee:set-payload></ee:message>
    </ee:transform>
</on-error-propagate>
<on-error-propagate type="CUSTOM:INVALID_TRANSITION" logException="false" doc:name="409 Invalid transition">
    <set-variable variableName="httpStatus" value="#[409]"/>
    <ee:transform doc:name="Error body">
        <ee:message><ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
  errorCode: "INVALID_STATUS_TRANSITION",
  message: error.description,
  currentStatus: vars.currentStatus,
  correlationId: vars.correlationId default correlationId
}]]></ee:set-payload></ee:message>
    </ee:transform>
</on-error-propagate>
		<on-error-propagate type="MULE:CONNECTIVITY, MULE:RETRY_EXHAUSTED" logException="true" doc:name="503 Backend unavailable">
    <set-variable variableName="httpStatus" value="#[503]"/>
    <ee:transform doc:name="Error body">
        <ee:message><ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
  errorCode: "SERVICE_UNAVAILABLE",
  message: "A required backend service is unavailable. Please retry later.",
  correlationId: vars.correlationId default correlationId
}]]></ee:set-payload></ee:message>
        <ee:variables>
            <ee:set-variable variableName="outboundHeaders"><![CDATA[%dw 2.0
output application/java
---
{ "Retry-After": p('api.retryAfterSeconds') }]]></ee:set-variable>
        </ee:variables>
    </ee:transform>
</on-error-propagate>
        <on-error-propagate type="ANY" doc:name="500 Internal Error">
            <set-variable variableName="httpStatus" value="#[500]"/>
            <ee:transform doc:name="Error body">
                <ee:message><ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{ errorCode: "INTERNAL_ERROR", message: "An unexpected error occurred.", correlationId: vars.correlationId default correlationId }]]></ee:set-payload></ee:message>
            </ee:transform>
        </on-error-propagate>

    </error-handler>

</mule>